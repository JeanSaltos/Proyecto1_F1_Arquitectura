    {
      "name": "6. GraphQL Gateway (:8080)",
      "item": [
        {
          "name": "Crear Pedido (GraphQL Mutation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CrearNuevoPedido($clienteId: ID!) {\n  crearPedido(input: {\n    clienteId: $clienteId\n    descripcion: \"Carga de insumos medicos\"\n    peso: 75.8\n    origen: \"Quito\"\n    destino: \"Guayaquil\"\n    prioridad: ALTA\n  }) {\n    id\n    estado\n    prioridad\n  }\n}",
                "variables": "{\n  \"clienteId\": \"{{cliente_id}}\"\n}"
              }
            },
            "url": {
              "raw": "http://localhost:8080/graphql",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "graphql"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Obtener Detalle de Envío (GraphQL Query)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query ConsultarEnvio($envioId: ID!) {\n  envio(id: $envioId) {\n    id\n    ruta\n    estado\n    kms\n    eta\n  }\n}",
                "variables": "{\n  \"envioId\": \"{{envio_id}}\"\n}"
              }
            },
            "url": {
              "raw": "http://localhost:8080/graphql",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "graphql"
              ]
            }
          },
          "response": []
        }
      ]
